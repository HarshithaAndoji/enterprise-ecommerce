# Environment variables
# Copy to `.env.local` (git-ignored) and adjust for your backend.

# Root URL of the REST API.
# Leave it empty to run the app on the bundled dev data (src/services/dev).
# When set, all services switch to real HTTP calls automatically.
# Example: VITE_API_URL=http://localhost:5000/api
VITE_API_URL=

# Force the dev data layer even when VITE_API_URL is set.
# Useful for UI work while the backend is being finished.
# VITE_USE_MOCK_API=true

# Optional: base URL used by the Playwright end to end suite.
# E2E_BASE_URL=http://localhost:3000